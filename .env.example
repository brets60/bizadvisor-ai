# BizAdvisor AI Configuration

# 1. Google Gemini AI API Key (Required for live AI features)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Database Connection
# Supabase PostgreSQL or local PostgreSQL:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public
# For zero-config local development, SQLite file path can be used if configured:
DATABASE_URL="file:./dev.db"

# 3. Supabase Authentication & Client Configuration (Optional if using built-in session auth or Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 4. Security & JWT Session Secret (For fallback secure token verification)
JWT_SECRET="bizadvisor-super-secret-jwt-key-minimum-32-chars-long"

# 5. Default Localization
NEXT_PUBLIC_DEFAULT_CURRENCY="PHP"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Manila"
NEXT_PUBLIC_DEFAULT_COUNTRY="Philippines"
